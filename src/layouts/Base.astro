---
import "../styles/global.css";
const { title, description = "An American photograph monograph by Nate Jones." } = Astro.props;
const path = Astro.url.pathname;
const isMonograph = path === "/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · nate makes grain` : "nate makes grain"}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#1a1410" />
    <meta name="color-scheme" content="dark" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400;1,500&display=swap" />
  </head>
  <body>
    <header class="float-header" id="float-header" aria-label="Site navigation">
      <a class="wordmark" href="/">nate makes grain</a>
      <nav aria-label="Sections">
        {isMonograph ? (
          <>
            <a href="#chapter-1">work</a>
            <a href="#epilogue">about</a>
            <a href="/contact/">write</a>
          </>
        ) : (
          <>
            <a href="/">monograph</a>
            <a href="/contact/">write</a>
          </>
        )}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <span>&copy; {new Date().getFullYear()} nate jones — all photographs by the artist</span>
      <span class="footer-right">
        <a href="https://instagram.com/natemakesgrain" rel="me noopener" target="_blank">@natemakesgrain</a>
        <span aria-hidden="true">·</span>
        <a href="mailto:nate.jones@natemakesgrain.com">nate.jones@natemakesgrain.com</a>
      </span>
    </footer>

    {isMonograph && (
      <dialog class="lightbox" id="lightbox" aria-label="Photograph viewer">
        <div class="lightbox-inner">
          <button class="lightbox-close" type="button" aria-label="Close" data-close>close</button>
          <button class="lightbox-nav prev" type="button" aria-label="Previous photograph" data-prev>‹</button>
          <button class="lightbox-nav next" type="button" aria-label="Next photograph" data-next>›</button>
          <img id="lightbox-img" alt="" />
          <div class="lightbox-meta">
            <p class="lightbox-title" id="lightbox-title"></p>
            <a class="lightbox-cta" id="lightbox-inquire" href="/contact/">request a print</a>
          </div>
        </div>
      </dialog>
    )}

    {isMonograph && (
      <script>
        /* Show floating header once the user scrolls past the hero. */
        const header = document.getElementById('float-header');
        const hero = document.querySelector('.hero');
        if (header && hero) {
          const io = new IntersectionObserver(([entry]) => {
            header.classList.toggle('is-visible', !entry.isIntersecting);
          }, { rootMargin: '-30% 0px 0px 0px' });
          io.observe(hero);
          hero.classList.add('is-loaded');
        } else if (header) {
          header.classList.add('is-visible');
        }

        /* Reveal-on-scroll for spreads. */
        const revealEls = document.querySelectorAll('.reveal');
        if ('IntersectionObserver' in window) {
          const ro = new IntersectionObserver((entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                ro.unobserve(e.target);
              }
            }
          }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
          revealEls.forEach(el => ro.observe(el));
        } else {
          revealEls.forEach(el => el.classList.add('in'));
        }

        /* ---------- Lightbox ---------- */
        const dialog = document.getElementById('lightbox');
        const tiles = Array.from(document.querySelectorAll('button.tile'));
        const lbImg = document.getElementById('lightbox-img');
        const lbTitle = document.getElementById('lightbox-title');
        const lbInquire = document.getElementById('lightbox-inquire');
        const lbPrev = dialog ? dialog.querySelector('[data-prev]') : null;
        const lbNext = dialog ? dialog.querySelector('[data-next]') : null;

        let currentIdx = -1;
        let triggerEl = null;

        function showAt(idx) {
          if (idx < 0 || idx >= tiles.length) return;
          currentIdx = idx;
          const t = tiles[idx];
          const img = t.querySelector('img');
          if (!img || !lbImg || !lbTitle || !lbInquire) return;
          lbImg.src = img.currentSrc || img.src;
          lbImg.alt = img.alt;
          const title = t.dataset.title || '';
          lbTitle.textContent = title;
          const subject = `Print inquiry: ${title}`;
          lbInquire.href = `/contact/?subject=${encodeURIComponent(subject)}`;
          if (lbPrev) lbPrev.disabled = idx <= 0;
          if (lbNext) lbNext.disabled = idx >= tiles.length - 1;
        }

        function openAt(idx, opener) {
          triggerEl = opener;
          showAt(idx);
          if (dialog && typeof dialog.showModal === 'function') dialog.showModal();
        }

        tiles.forEach((t, i) => {
          t.addEventListener('click', () => openAt(i, t));
        });

        if (dialog) {
          if (lbPrev) lbPrev.addEventListener('click', () => showAt(currentIdx - 1));
          if (lbNext) lbNext.addEventListener('click', () => showAt(currentIdx + 1));

          dialog.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowLeft') { e.preventDefault(); showAt(currentIdx - 1); }
            if (e.key === 'ArrowRight') { e.preventDefault(); showAt(currentIdx + 1); }
          });

          dialog.addEventListener('click', (e) => {
            const target = e.target;
            if (target && (target.matches('[data-close]') || target === dialog)) dialog.close();
          });

          dialog.addEventListener('close', () => {
            if (triggerEl && typeof triggerEl.focus === 'function') {
              triggerEl.focus({ preventScroll: false });
            }
            triggerEl = null;
            currentIdx = -1;
          });
        }
      </script>
    )}

    {!isMonograph && (
      <script>
        const header = document.getElementById('float-header');
        if (header) header.classList.add('is-visible');
      </script>
    )}
  </body>
</html>
