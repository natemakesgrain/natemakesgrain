---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { photos } from "../data/photos.js";

const byId = Object.fromEntries(photos.map(p => [p.id, p]));
const get = (id) => {
  const p = byId[id];
  if (!p) throw new Error(`Photo not found: ${id}`);
  return p;
};

/* One portfolio, nineteen frames, five movements — sequenced as tonal
   music: a violet-blue nocturne (01–03), a chroma crescendo peaking at
   King's (04–07), a snow decrescendo (08–11), a B&W adagio (12–18),
   and a colored coda (19) that answers the hero. "full" spreads are
   plates that bleed to the viewport edge on their constrained axis;
   "turn" marks a movement boundary with extra breathing room. Pair
   order is deliberate: gaze/vectors bind toward the gutter. */

const hero = { id: "fisherman-at-blue-hour", num: "01" };

const spreads = [
  /* I. Nocturne — the hero's grammar restated: small figure, vast dusk field */
  { type: "pair", ids: ["cherub-fountain-twilight", "country-road-walker-and-dog"],        nums: ["02", "03"] },
  /* II. Crescendo — dawn breaks cyan, chroma builds to hard sun */
  { type: "full", id: "azure",                                                             num: "04",
    sizes: "(orientation: landscape) 80vh, 100vw" },
  { type: "pair", ids: ["pink-wall-houston", "plaza-mist"],                                nums: ["05", "06"], turn: true },
  { type: "full", id: "kings-sandwich-shop-durham",                                        num: "07",
    sizes: "(orientation: landscape) 100vh, 100vw" },
  /* III. Decrescendo — the lights come on, snow drains the palette */
  { type: "pair", ids: ["durham-chesterfield-warehouse", "snowy-tennis-court-lamppost-night"], nums: ["08", "09"], turn: true },
  { type: "pair", ids: ["park-first-snow", "snow-umbrellas-park"],                         nums: ["10", "11"] },
  /* IV. Adagio — color falls away; monuments, apertures, drought, exhale */
  { type: "pair", ids: ["circus-circus-clown-las-vegas", "de-young-museum-tower"],         nums: ["12", "13"], turn: true },
  { type: "full", id: "architectural-cutout-smokestack",                                   num: "14",
    sizes: "(orientation: landscape) 133vh, 100vw" },
  { type: "pair", ids: ["mission-doorway-san-antonio", "sprawling-mesquite-tree-pavilion-bw"], nums: ["15", "16"] },
  { type: "pair", ids: ["low-water", "white-tower"],                                       nums: ["17", "18"] },
  /* V. Coda — color returns: one lit window answers the fisherman */
  { type: "full", id: "one-window-twilight",                                               num: "19", closer: true,
    sizes: "(orientation: landscape) min(64vh, 900px), 92vw" },
];

const heroPhoto = get(hero.id);
---
<Base
  title=""
  description="Photographs by Nate Jones — Durham, North Carolina."
>
  {/* HERO — frame 01, full bleed */}
  <section class="hero" id="top" data-screen-label="Hero">
    <button
      type="button"
      class="tile"
      aria-label={`Open ${heroPhoto.title} in full view`}
      data-num={hero.num}
      data-title={heroPhoto.title}
    >
      <Image
        src={heroPhoto.src}
        alt={heroPhoto.alt}
        widths={[800, 1300, 1800, 2400]}
        sizes="100vw"
        loading="eager"
        decoding="async"
      />
    </button>
    <div class="hero-meta">
      <div>
        <h1 class="hero-mark">natemakesgrain<span class="dot">.</span></h1>
        <p class="hero-byline">photographs by Nate Jones — Durham, North Carolina</p>
      </div>
      <p class="hero-count">19 FRAMES ↓</p>
    </div>
  </section>

  {spreads.map((s, si) => {
    const anchor = si === 0 ? "work" : undefined;

    if (s.type === "full") {
      const p = get(s.id);
      return (
        <section class:list={["spread", "full", s.closer && "closer", s.turn && "turn"]} id={anchor}>
          <div class="stack">
            <button
              type="button"
              class="tile"
              aria-label={`Open ${p.title} in full view`}
              data-num={s.num}
              data-title={p.title}
            >
              <Image
                src={p.src}
                alt={p.alt}
                widths={[800, 1300, 1800, 2400]}
                sizes={s.sizes}
                loading="lazy"
                decoding="async"
              />
            </button>
            <div class="frame-num">{s.num}</div>
          </div>
        </section>
      );
    }

    const [a, b] = s.ids.map(get);
    const [na, nb] = s.nums;
    return (
      <section class:list={["spread", "pair", s.turn && "turn"]} id={anchor}>
        <figure>
          <button
            type="button"
            class="tile"
            aria-label={`Open ${a.title} in full view`}
            data-num={na}
            data-title={a.title}
          >
            <Image
              src={a.src}
              alt={a.alt}
              widths={[400, 600, 900, 1200]}
              sizes="(max-width: 760px) 100vw, (max-width: 1700px) 45vw, 765px"
              loading="lazy"
              decoding="async"
            />
          </button>
          <figcaption class="frame-num">{na}</figcaption>
        </figure>
        <figure>
          <button
            type="button"
            class="tile"
            aria-label={`Open ${b.title} in full view`}
            data-num={nb}
            data-title={b.title}
          >
            <Image
              src={b.src}
              alt={b.alt}
              widths={[400, 600, 900, 1200]}
              sizes="(max-width: 760px) 100vw, (max-width: 1700px) 45vw, 765px"
              loading="lazy"
              decoding="async"
            />
          </button>
          <figcaption class="frame-num">{nb}</figcaption>
        </figure>
      </section>
    );
  })}

  {/* CONTACT */}
  <section class="contact" id="contact" data-screen-label="Contact">
    <p class="contact-kicker">Prints · Licensing · Assignments</p>
    <h2>Working from Durham, North Carolina. The inbox is open.</h2>
    <a class="contact-mail js-copy-mail" href="mailto:nate.jones@natemakesgrain.com">nate.jones@natemakesgrain.com</a>
    <div class="contact-meta">
      <a href="https://instagram.com/natemakesgrain" rel="me noopener" target="_blank">Instagram — @natemakesgrain</a>
      <span>Durham, NC</span>
    </div>
  </section>
</Base>
