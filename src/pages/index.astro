---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { photos } from "../data/photos.js";

const byId = Object.fromEntries(photos.map(p => [p.id, p]));
const get = (id) => {
  const p = byId[id];
  if (!p) throw new Error(`Photo not found: ${id}`);
  return p;
};

/* The monograph sequence. Each entry is a spread the reader
   scrolls past. Slot types: hero, chapter, full, large,
   single, offset (left|right), diptych. */

const spreads = [
  { type: "hero" },

  // I.  SIGN — vernacular surfaces: neon, marquee, painted lettering, storefronts
  { type: "chapter", num: "I.", name: "Sign", intro: "Neon, marquee, painted lettering. The road traveled past it." },
  { type: "full",    id: "kings-sandwich-shop-durham", num: "01" },
  { type: "diptych", ids: ["carolina-cinema-neon", "tennessee-theatre-knoxville"], nums: ["02", "03"] },
  { type: "large",   id: "bit-and-spur-saloon-springdale-dusk", num: "04" },
  { type: "diptych", ids: ["boogie-woogie-bourbon", "entrecote-late"], nums: ["05", "06"] },
  { type: "offset", side: "right", id: "kingfisher-bar-neon-night", num: "07" },
  { type: "full",    id: "tracks-crossing", num: "08" },
  { type: "diptych", ids: ["boutique-du-vampyre", "drummers-bourbon"], nums: ["09", "10"] },
  { type: "diptych", ids: ["guaranteed-shorter-hair-barbershop", "geerhouse-tow-away-durham"], nums: ["11", "12"] },
  { type: "diptych", ids: ["old-north-durham-open-sign", "bull-city-car-wash-durham"], nums: ["13", "14"] },
  { type: "single",  id: "texas-neon-adv-co-sign", num: "15" },
  { type: "offset", side: "left", id: "old-north-bar-sign", num: "16" },

  // II.  ADVENTURE — distance, country, weather, road, the in-between
  { type: "chapter", num: "II.", name: "Adventure", intro: "Distance, country, weather. The work made on the way." },
  { type: "full",    id: "country-road-walker-and-dog", num: "17" },
  { type: "large",   id: "red-sandstone-cliff-canyon-sunset", num: "18" },
  { type: "large",   id: "zion-canyon-overlook", num: "19" },
  { type: "diptych", ids: ["park-first-snow", "snowy-tennis-court-lamppost-night"], nums: ["20", "21"] },
  { type: "diptych", ids: ["snow-day-dog-walk", "outstretched-branch-mountain-overlook"], nums: ["22", "23"] },
  { type: "single",  id: "wooded-pond-radio-tower", num: "24" },
  { type: "offset", side: "right", id: "sprawling-mesquite-tree-pavilion", num: "25" },
  { type: "full",    id: "plaza-mist", num: "26" },
  { type: "single",  id: "pink-wall-houston", num: "27" },

  // III.  FORM — architecture, monument, doorway, tower, column
  { type: "chapter", num: "III.", name: "Form", intro: "Architecture, monument, doorway. Stone and concrete and column." },
  { type: "full",    id: "mission-doorway-san-antonio", num: "28" },
  { type: "diptych", ids: ["domed-classical-auditorium", "brutalist-concrete-beams"], nums: ["29", "30"] },
  { type: "single",  id: "industrial-funnel-water-feature", num: "31" },
  { type: "full",    id: "de-young-museum-tower", num: "32" },
  { type: "diptych", ids: ["mission-vaulted-interior", "manhattan-looking-downtown"], nums: ["33", "34"] },
  { type: "offset", side: "left", id: "old-and-new", num: "35" },
  { type: "diptych", ids: ["architectural-cutout-smokestack", "nyc-subway-tile-wall"], nums: ["36", "37"] },

  // IV.  QUIET — interiors, still lifes, slow time
  { type: "chapter", num: "IV.", name: "Quiet", intro: "Indoors, mostly. The slow time before and after." },
  { type: "full",    id: "concourse-grand-central", num: "38" },
  { type: "diptych", ids: ["houseplant-shop-interior", "stucco-storefront-shadows"], nums: ["39", "40"] },
  { type: "diptych", ids: ["morning-coffee-table-still-life", "coffee-shop-interior"], nums: ["41", "42"] },
  { type: "diptych", ids: ["rouses-french-quarter", "woman-brick-wall-piedras-building"], nums: ["43", "44"] },
  { type: "full",    id: "painted-lady-dusk", num: "45" },
  { type: "diptych", ids: ["white-telephone-booth-dock", "red-phone-booths-bermuda"], nums: ["46", "47"] },
  { type: "large",   id: "cherub-fountain-twilight", num: "48" },
  { type: "single",  id: "one-window-twilight", num: "49" },
];

const chapterTotal = spreads.filter(s => s.type === "chapter").length;

/* Compute frame counts per chapter so the chapter cards stay honest. */
const chapterCounts = (() => {
  const counts = {};
  let current = null;
  for (const s of spreads) {
    if (s.type === "chapter") { current = s.name; counts[current] = 0; }
    else if (s.type === "diptych" && current) counts[current] += s.ids.length;
    else if (s.id && current) counts[current] += 1;
  }
  return counts;
})();

let chapterIdx = 0;

const toneLabel = (p) => p.tone === "monochrome" ? "monochrome" : "color";
---
<Base
  title=""
  description="nate makes grain — an ongoing photograph monograph by Nate Jones. Fine art photography on film, in four movements."
>
  {/* HERO */}
  <section class="hero" id="top">
    <p class="hero-kicker">an ongoing photograph monograph</p>
    <h1 class="hero-mark">
      nate <em>makes</em> grain
    </h1>
    <div class="hero-meta">
      <p class="hero-subtitle">
        Photographs by <em>Nate Jones</em>, made on Kodak Ektachrome color and Kodak T-MAX black-and-white film. In four movements: sign, adventure, form, quiet.
      </p>
      <p class="hero-scroll">scroll to begin</p>
    </div>
  </section>

  {spreads.slice(1).map((s) => {
    if (s.type === "chapter") {
      chapterIdx += 1;
      const anchor = `chapter-${chapterIdx}`;
      const mirror = chapterIdx % 2 === 0;
      return (
        <section
          class:list={["chapter", "reveal", mirror && "chapter--mirror"]}
          id={anchor}
          data-chapter-name={s.name}
        >
          <p class="chapter-num">{s.num}</p>
          <div class="chapter-body">
            <h2 class="chapter-name">{s.name}</h2>
            <p class="chapter-intro">
              {s.intro}
              <span class="chapter-count">{chapterCounts[s.name]} frames</span>
            </p>
          </div>
        </section>
      );
    }

    if (s.type === "full") {
      const p = get(s.id);
      return (
        <section class="spread full reveal">
          <figure class="frame">
            <button
              type="button"
              class="tile"
              aria-label={`Open ${p.title} in full view`}
              data-id={p.id}
              data-title={p.title}
              data-place={p.alt}
              data-tone={p.tone}
              data-num={s.num}
            >
              <Image
                src={p.src}
                alt={p.alt}
                widths={[800, 1300, 1800, 2400]}
                sizes="100vw"
                loading="lazy"
                decoding="async"
              />
            </button>
          </figure>
          <p class="caption">
            <span class="title">{p.title}</span>
          </p>
          <span class="page-num">p. {s.num}</span>
        </section>
      );
    }

    if (s.type === "large") {
      const p = get(s.id);
      return (
        <section class="spread large reveal">
          <figure class="frame">
            <button
              type="button"
              class="tile"
              aria-label={`Open ${p.title} in full view`}
              data-id={p.id}
              data-title={p.title}
              data-place={p.alt}
              data-tone={p.tone}
              data-num={s.num}
            >
              <Image
                src={p.src}
                alt={p.alt}
                widths={[600, 1000, 1400, 1800]}
                sizes="(max-width: 760px) 100vw, min(80vw, 1280px)"
                loading="lazy"
                decoding="async"
              />
            </button>
          </figure>
          <p class="caption">
            <span class="title">{p.title}</span>
          </p>
          <span class="page-num">p. {s.num}</span>
        </section>
      );
    }

    if (s.type === "single") {
      const p = get(s.id);
      return (
        <section class="spread single reveal">
          <figure class="frame">
            <button
              type="button"
              class="tile"
              aria-label={`Open ${p.title} in full view`}
              data-id={p.id}
              data-title={p.title}
              data-place={p.alt}
              data-tone={p.tone}
              data-num={s.num}
            >
              <Image
                src={p.src}
                alt={p.alt}
                widths={[500, 800, 1100]}
                sizes="(max-width: 760px) 100vw, min(56vw, 760px)"
                loading="lazy"
                decoding="async"
              />
            </button>
          </figure>
          <p class="caption">
            <span class="title">{p.title}</span>
          </p>
          <span class="page-num">p. {s.num}</span>
        </section>
      );
    }

    if (s.type === "offset") {
      const p = get(s.id);
      const side = s.side || "left";
      return (
        <section class:list={["spread", "offset", side, "reveal"]}>
          <div class="frame-row">
            <figure class="frame">
              <button
                type="button"
                class="tile"
                aria-label={`Open ${p.title} in full view`}
                data-id={p.id}
                data-title={p.title}
                data-place={p.alt}
                data-tone={p.tone}
                data-num={s.num}
              >
                <Image
                  src={p.src}
                  alt={p.alt}
                  widths={[500, 800, 1100]}
                  sizes="(max-width: 760px) 100vw, min(50vw, 800px)"
                  loading="lazy"
                  decoding="async"
                />
              </button>
            </figure>
            <div class="caption-block">
              <span class="title">{p.title}</span>
              <span class="place">{p.alt}</span>
            </div>
          </div>
          <span class="page-num">p. {s.num}</span>
        </section>
      );
    }

    if (s.type === "diptych") {
      const [a, b] = s.ids.map(get);
      const [na, nb] = s.nums;
      return (
        <section class="spread diptych reveal">
          <div class="pair">
            <figure>
              <div class="frame">
                <button
                  type="button"
                  class="tile"
                  aria-label={`Open ${a.title} in full view`}
                  data-id={a.id}
                  data-title={a.title}
                  data-place={a.alt}
                  data-tone={a.tone}
                  data-num={na}
                >
                  <Image
                    src={a.src}
                    alt={a.alt}
                    widths={[400, 600, 900, 1200]}
                    sizes="(max-width: 760px) 100vw, 45vw"
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              </div>
              <p class="caption">
                <span class="title">{a.title}</span>
              </p>
            </figure>
            <figure>
              <div class="frame">
                <button
                  type="button"
                  class="tile"
                  aria-label={`Open ${b.title} in full view`}
                  data-id={b.id}
                  data-title={b.title}
                  data-place={b.alt}
                  data-tone={b.tone}
                  data-num={nb}
                >
                  <Image
                    src={b.src}
                    alt={b.alt}
                    widths={[400, 600, 900, 1200]}
                    sizes="(max-width: 760px) 100vw, 45vw"
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              </div>
              <p class="caption">
                <span class="title">{b.title}</span>
              </p>
            </figure>
          </div>
          <span class="page-num">p. {na}—{nb}</span>
        </section>
      );
    }

    return null;
  })}

  {/* EPILOGUE — about + contact integrated as the closing spread */}
  <section class="epilogue reveal" id="epilogue">
    <p class="epilogue-kicker">a colophon</p>
    <h2 class="epilogue-mark">
      Nate Jones, <em>Durham</em>,<br />North Carolina.
    </h2>

    <div class="epilogue-prose">
      <p>
        Photographs of signs, adventure, form and the quiet hour, made on Kodak Ektachrome color and Kodak T-MAX black-and-white film. The work is patient, observational, and almost always tied to a particular place. The monograph adds frames as new ones are made.
      </p>
      <p>
        Prints, licensing, and editorial assignments go straight to the inbox at <a href="/contact/">the contact page</a>. Replies come from <a href="mailto:nate.jones@natemakesgrain.com">nate.jones@natemakesgrain.com</a>, not a form.
      </p>
    </div>

    <aside class="epilogue-meta">
      <dl>
        <dt>Based in</dt>
        <dd>Durham, North Carolina</dd>
        <dt>On film</dt>
        <dd>Kodak Ektachrome, Kodak T-MAX</dd>
        <dt>Status</dt>
        <dd>Ongoing</dd>
        <dt>Instagram</dt>
        <dd><a href="https://instagram.com/natemakesgrain" rel="me noopener" target="_blank">@natemakesgrain</a></dd>
        <dt>Write</dt>
        <dd><a href="mailto:nate.jones@natemakesgrain.com">nate.jones@natemakesgrain.com</a></dd>
      </dl>
    </aside>
  </section>
</Base>
