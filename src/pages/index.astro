---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { photos } from "../data/photos.js";

const byId = Object.fromEntries(photos.map(p => [p.id, p]));
const get = (id) => {
  const p = byId[id];
  if (!p) throw new Error(`Photo not found: ${id}`);
  return p;
};

/* The monograph sequence. Each entry is a spread the reader
   scrolls past. Slot types: hero, chapter, full, large,
   single, offset (left|right), diptych. */

/* Two movements: HOURS (color, the lit hours) and MASS (b&w, what holds
   and outlasts). 29 frames total, continuously numbered p. 01—29.
   Singletons render full-bleed; diptych pairs share a page-spread. */

const spreads = [
  { type: "hero" },

  // I.  HOURS — daylight, neon, snow, twilight (color)
  { type: "chapter", num: "I.", name: "Hours", intro: "Daylight, neon, snow, twilight. The lit hours of place." },
  { type: "full",    id: "kings-sandwich-shop-durham",                                                   num: "01" },
  { type: "diptych", ids: ["shooters-saloon-durham", "bull-city-car-wash-durham"],                       nums: ["02", "03"] },
  { type: "full",    id: "pink-wall-houston",                                                            num: "04" },
  { type: "diptych", ids: ["carolina-cinema-neon", "kingfisher-bar-neon-night"],                         nums: ["05", "06"] },
  { type: "full",    id: "bit-and-spur-saloon-springdale-dusk",                                          num: "07" },
  { type: "full",    id: "old-north-durham-open-sign",                                                   num: "08" },
  { type: "diptych", ids: ["plaza-mist", "snow-umbrellas-park"],                                         nums: ["09", "10"] },
  { type: "diptych", ids: ["park-first-snow", "snowy-tennis-court-lamppost-night"],                      nums: ["11", "12"] },
  { type: "full",    id: "cherub-fountain-twilight",                                                     num: "13" },
  { type: "diptych", ids: ["painted-lady-dusk", "one-window-twilight"],                                  nums: ["14", "15"] },

  // II.  MASS — what holds and outlasts (black-and-white)
  { type: "chapter", num: "II.", name: "Mass", intro: "Doorway, vault, tank, beam. What holds and outlasts." },
  { type: "full",    id: "architectural-cutout-smokestack",                                              num: "16" },
  { type: "diptych", ids: ["not-in-use-tanks", "industrial-funnel-water-feature"],                       nums: ["17", "18"] },
  { type: "diptych", ids: ["mission-doorway-san-antonio", "mission-vaulted-interior"],                   nums: ["19", "20"] },
  { type: "diptych", ids: ["geerhouse-tow-away-durham", "stucco-storefront-shadows"],                    nums: ["21", "22"] },
  { type: "diptych", ids: ["brutalist-concrete-beams", "de-young-museum-tower"],                         nums: ["23", "24"] },
  { type: "full",    id: "domed-classical-auditorium",                                                   num: "25" },
  { type: "diptych", ids: ["nyc-subway-tile-wall", "concourse-grand-central"],                           nums: ["26", "27"] },
  { type: "diptych", ids: ["sprawling-mesquite-tree-pavilion-bw", "gooseneck-lamppost-infrared"],        nums: ["28", "29"] },
];

const chapterTotal = spreads.filter(s => s.type === "chapter").length;

/* Compute frame counts per chapter so the chapter cards stay honest. */
const chapterCounts = (() => {
  const counts = {};
  let current = null;
  for (const s of spreads) {
    if (s.type === "chapter") { current = s.name; counts[current] = 0; }
    else if (s.type === "diptych" && current) counts[current] += s.ids.length;
    else if (s.id && current) counts[current] += 1;
  }
  return counts;
})();

let chapterIdx = 0;

const toneLabel = (p) => p.tone === "monochrome" ? "monochrome" : "color";
---
<Base
  title=""
  description="nate makes grain — an ongoing photograph monograph by Nate Jones."
>
  {/* HERO */}
  <section class="hero" id="top">
    <p class="hero-kicker">an ongoing photograph monograph</p>
    <h1 class="hero-mark">
      nate <em>makes</em> grain
    </h1>
    <div class="hero-meta">
      <p class="hero-subtitle">
        Photographs by <em>Nate Jones</em>. In two movements: hours, mass.
      </p>
      <p class="hero-scroll">scroll to begin</p>
    </div>
  </section>

  {spreads.slice(1).map((s) => {
    if (s.type === "chapter") {
      chapterIdx += 1;
      const anchor = `chapter-${chapterIdx}`;
      const mirror = chapterIdx % 2 === 0;
      return (
        <section
          class:list={["chapter", "reveal", mirror && "chapter--mirror"]}
          id={anchor}
          data-chapter-name={s.name}
        >
          <p class="chapter-num">{s.num}</p>
          <div class="chapter-body">
            <h2 class="chapter-name">{s.name}</h2>
            <p class="chapter-intro">
              {s.intro}
              <span class="chapter-count">{chapterCounts[s.name]} frames</span>
            </p>
          </div>
        </section>
      );
    }

    if (s.type === "full") {
      const p = get(s.id);
      return (
        <section class="spread full reveal">
          <figure class="frame">
            <button
              type="button"
              class="tile"
              aria-label={`Open ${p.title} in full view`}
              data-id={p.id}
              data-title={p.title}
              data-place={p.alt}
              data-tone={p.tone}
              data-num={s.num}
            >
              <Image
                src={p.src}
                alt={p.alt}
                widths={[800, 1300, 1800, 2400]}
                sizes="100vw"
                loading="lazy"
                decoding="async"
              />
            </button>
          </figure>
          <p class="caption">
            <span class="title">{p.title}</span>
          </p>
          <span class="page-num">p. {s.num}</span>
        </section>
      );
    }

    if (s.type === "large") {
      const p = get(s.id);
      return (
        <section class="spread large reveal">
          <figure class="frame">
            <button
              type="button"
              class="tile"
              aria-label={`Open ${p.title} in full view`}
              data-id={p.id}
              data-title={p.title}
              data-place={p.alt}
              data-tone={p.tone}
              data-num={s.num}
            >
              <Image
                src={p.src}
                alt={p.alt}
                widths={[600, 1000, 1400, 1800]}
                sizes="(max-width: 760px) 100vw, min(80vw, 1280px)"
                loading="lazy"
                decoding="async"
              />
            </button>
          </figure>
          <p class="caption">
            <span class="title">{p.title}</span>
          </p>
          <span class="page-num">p. {s.num}</span>
        </section>
      );
    }

    if (s.type === "single") {
      const p = get(s.id);
      return (
        <section class="spread single reveal">
          <figure class="frame">
            <button
              type="button"
              class="tile"
              aria-label={`Open ${p.title} in full view`}
              data-id={p.id}
              data-title={p.title}
              data-place={p.alt}
              data-tone={p.tone}
              data-num={s.num}
            >
              <Image
                src={p.src}
                alt={p.alt}
                widths={[500, 800, 1100]}
                sizes="(max-width: 760px) 100vw, min(56vw, 760px)"
                loading="lazy"
                decoding="async"
              />
            </button>
          </figure>
          <p class="caption">
            <span class="title">{p.title}</span>
          </p>
          <span class="page-num">p. {s.num}</span>
        </section>
      );
    }

    if (s.type === "offset") {
      const p = get(s.id);
      const side = s.side || "left";
      return (
        <section class:list={["spread", "offset", side, "reveal"]}>
          <div class="frame-row">
            <figure class="frame">
              <button
                type="button"
                class="tile"
                aria-label={`Open ${p.title} in full view`}
                data-id={p.id}
                data-title={p.title}
                data-place={p.alt}
                data-tone={p.tone}
                data-num={s.num}
              >
                <Image
                  src={p.src}
                  alt={p.alt}
                  widths={[500, 800, 1100]}
                  sizes="(max-width: 760px) 100vw, min(50vw, 800px)"
                  loading="lazy"
                  decoding="async"
                />
              </button>
            </figure>
            <div class="caption-block">
              <span class="title">{p.title}</span>
              <span class="place">{p.alt}</span>
            </div>
          </div>
          <span class="page-num">p. {s.num}</span>
        </section>
      );
    }

    if (s.type === "diptych") {
      const [a, b] = s.ids.map(get);
      const [na, nb] = s.nums;
      return (
        <section class="spread diptych reveal">
          <div class="pair">
            <figure>
              <div class="frame">
                <button
                  type="button"
                  class="tile"
                  aria-label={`Open ${a.title} in full view`}
                  data-id={a.id}
                  data-title={a.title}
                  data-place={a.alt}
                  data-tone={a.tone}
                  data-num={na}
                >
                  <Image
                    src={a.src}
                    alt={a.alt}
                    widths={[400, 600, 900, 1200]}
                    sizes="(max-width: 760px) 100vw, 45vw"
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              </div>
              <p class="caption">
                <span class="title">{a.title}</span>
              </p>
            </figure>
            <figure>
              <div class="frame">
                <button
                  type="button"
                  class="tile"
                  aria-label={`Open ${b.title} in full view`}
                  data-id={b.id}
                  data-title={b.title}
                  data-place={b.alt}
                  data-tone={b.tone}
                  data-num={nb}
                >
                  <Image
                    src={b.src}
                    alt={b.alt}
                    widths={[400, 600, 900, 1200]}
                    sizes="(max-width: 760px) 100vw, 45vw"
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              </div>
              <p class="caption">
                <span class="title">{b.title}</span>
              </p>
            </figure>
          </div>
          <span class="page-num">p. {na}—{nb}</span>
        </section>
      );
    }

    return null;
  })}

  {/* EPILOGUE — about + contact integrated as the closing spread.
       Road, with Dog appears as a quiet signature image above the heading. */}
  <section class="epilogue reveal" id="epilogue">
    {(() => {
      const p = get("country-road-walker-and-dog");
      return (
        <figure class="epilogue-hero">
          <Image
            src={p.src}
            alt={p.alt}
            widths={[800, 1300, 1800, 2400]}
            sizes="(max-width: 760px) 100vw, min(100vw, 1300px)"
            loading="lazy"
            decoding="async"
          />
        </figure>
      );
    })()}

    <p class="epilogue-kicker">a colophon</p>
    <h2 class="epilogue-mark">
      Nate Jones, <em>Durham</em>,<br />North Carolina.
    </h2>

    <div class="epilogue-prose">
      <p>
        The work is patient, observational, and almost always tied to a particular place. The monograph adds frames as new ones are made.
      </p>
      <p>
        Prints, licensing, and editorial assignments go straight to the inbox at <a href="/contact/">the contact page</a>. Replies come from <a href="mailto:nate.jones@natemakesgrain.com">nate.jones@natemakesgrain.com</a>, not a form.
      </p>
    </div>

    <aside class="epilogue-meta">
      <dl>
        <dt>Based in</dt>
        <dd>Durham, North Carolina</dd>
        <dt>Status</dt>
        <dd>Ongoing</dd>
        <dt>Instagram</dt>
        <dd><a href="https://instagram.com/natemakesgrain" rel="me noopener" target="_blank">@natemakesgrain</a></dd>
        <dt>Write</dt>
        <dd><a href="mailto:nate.jones@natemakesgrain.com">nate.jones@natemakesgrain.com</a></dd>
      </dl>
    </aside>
  </section>
</Base>
