---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { photos } from "../data/photos.js";

const byId = Object.fromEntries(photos.map(p => [p.id, p]));
const get = (id) => {
  const p = byId[id];
  if (!p) throw new Error(`Photo not found: ${id}`);
  return p;
};

/* One portfolio, nineteen frames. "full" spreads get the page to
   themselves; "pair" spreads share it. Frame numbers run 01–19.
   The hero is frame 01. Captions appear only on hover (placard)
   and in the lightbox. */

const hero = { id: "fisherman-at-blue-hour", num: "01" };

const spreads = [
  { type: "pair", ids: ["cherub-fountain-twilight", "azure"],                              nums: ["02", "03"] },
  { type: "full", id: "kings-sandwich-shop-durham",                                        num: "04" },
  { type: "pair", ids: ["pink-wall-houston", "durham-chesterfield-warehouse"],             nums: ["05", "06"] },
  { type: "pair", ids: ["plaza-mist", "snowy-tennis-court-lamppost-night"],                nums: ["07", "08"] },
  { type: "pair", ids: ["country-road-walker-and-dog", "park-first-snow"],                 nums: ["09", "10"] },
  { type: "full", id: "snow-umbrellas-park",                                               num: "11" },
  { type: "full", id: "circus-circus-clown-las-vegas",                                     num: "12" },
  { type: "pair", ids: ["de-young-museum-tower", "architectural-cutout-smokestack"],       nums: ["13", "14"] },
  { type: "pair", ids: ["mission-doorway-san-antonio", "sprawling-mesquite-tree-pavilion-bw"], nums: ["15", "16"] },
  { type: "pair", ids: ["low-water", "white-tower"],                                       nums: ["17", "18"] },
  { type: "full", id: "one-window-twilight",                                               num: "19", closer: true },
];

const heroPhoto = get(hero.id);
---
<Base
  title=""
  description="Photographs by Nate Jones — Durham, North Carolina."
>
  {/* HERO — frame 01, full bleed */}
  <section class="hero" id="top" data-screen-label="Hero">
    <button
      type="button"
      class="tile"
      aria-label={`Open ${heroPhoto.title} in full view`}
      data-num={hero.num}
      data-title={heroPhoto.title}
    >
      <Image
        src={heroPhoto.src}
        alt={heroPhoto.alt}
        widths={[800, 1300, 1800, 2400]}
        sizes="100vw"
        loading="eager"
        decoding="async"
      />
    </button>
    <div class="hero-meta">
      <div>
        <h1 class="hero-mark">natemakesgrain<span class="dot">.</span></h1>
        <p class="hero-byline">photographs by Nate Jones — Durham, North Carolina</p>
      </div>
      <p class="hero-count">19 FRAMES ↓</p>
    </div>
  </section>

  {spreads.map((s, si) => {
    const anchor = si === 0 ? "work" : undefined;

    if (s.type === "full") {
      const p = get(s.id);
      return (
        <section class:list={["spread", "full", s.closer && "closer"]} id={anchor}>
          <div class="stack">
            <button
              type="button"
              class="tile"
              aria-label={`Open ${p.title} in full view`}
              data-num={s.num}
              data-title={p.title}
            >
              <Image
                src={p.src}
                alt={p.alt}
                widths={[800, 1300, 1800, 2400]}
                sizes={s.closer
                  ? "(max-width: 978px) 92vw, 900px"
                  : "(max-width: 1562px) 96vw, 1500px"}
                loading="lazy"
                decoding="async"
              />
            </button>
            <div class="frame-num">{s.num}</div>
          </div>
        </section>
      );
    }

    const [a, b] = s.ids.map(get);
    const [na, nb] = s.nums;
    return (
      <section class="spread pair" id={anchor}>
        <figure>
          <button
            type="button"
            class="tile"
            aria-label={`Open ${a.title} in full view`}
            data-num={na}
            data-title={a.title}
          >
            <Image
              src={a.src}
              alt={a.alt}
              widths={[400, 600, 900, 1200]}
              sizes="(max-width: 760px) 100vw, (max-width: 1700px) 45vw, 765px"
              loading="lazy"
              decoding="async"
            />
          </button>
          <figcaption class="frame-num">{na}</figcaption>
        </figure>
        <figure>
          <button
            type="button"
            class="tile"
            aria-label={`Open ${b.title} in full view`}
            data-num={nb}
            data-title={b.title}
          >
            <Image
              src={b.src}
              alt={b.alt}
              widths={[400, 600, 900, 1200]}
              sizes="(max-width: 760px) 100vw, (max-width: 1700px) 45vw, 765px"
              loading="lazy"
              decoding="async"
            />
          </button>
          <figcaption class="frame-num">{nb}</figcaption>
        </figure>
      </section>
    );
  })}

  {/* CONTACT */}
  <section class="contact" id="contact" data-screen-label="Contact">
    <p class="contact-kicker">Prints · Licensing · Assignments</p>
    <h2>Working from Durham, North Carolina. The inbox is open.</h2>
    <a class="contact-mail js-copy-mail" href="mailto:nate.jones@natemakesgrain.com">nate.jones@natemakesgrain.com</a>
    <div class="contact-meta">
      <a href="https://instagram.com/natemakesgrain" rel="me noopener" target="_blank">Instagram — @natemakesgrain</a>
      <span>Durham, NC</span>
    </div>
  </section>
</Base>
