---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { photos } from "../data/photos.js";

const byId = Object.fromEntries(photos.map(p => [p.id, p]));
const get = (id) => {
  const p = byId[id];
  if (!p) throw new Error(`Photo not found: ${id}`);
  return p;
};

/* One portfolio, twenty-three frames, one continuous story — out and
   back, dark to dark: the sea before dawn, blue morning, the loud town,
   out into the wild, the light dying into winter, the stark B&W west,
   and home to one lit window. "full" spreads are plates that bleed to
   the viewport edge on their constrained axis. Pair order is
   deliberate: gaze/vectors bind toward the gutter. */

const hero = { id: "fisherman-at-blue-hour", num: "01" };

const spreads = [
  /* the dark we set out in: fountain-glow and star-wheel */
  { type: "pair", ids: ["cherub-fountain-twilight", "star-trails-pines"],                  nums: ["02", "03"] },
  /* blue morning: sea-corner and city-corner, then summer in order */
  { type: "pair", ids: ["azure", "red-white-corner-shadow"],                               nums: ["04", "05"] },
  { type: "full", id: "beach-club-umbrellas",                                              num: "06",
    sizes: "(orientation: landscape) 80vh, 100vw" },
  /* the town, loud: pink answers turquoise, then the red peak */
  { type: "pair", ids: ["pink-wall-houston", "turquoise-peeling-wall"],                    nums: ["07", "08"] },
  { type: "full", id: "kings-sandwich-shop-durham",                                        num: "09",
    sizes: "(orientation: landscape) 100vh, 100vw" },
  /* out there: the town's made water beside wild water, then the far point */
  { type: "pair", ids: ["plaza-mist", "avalanche-creek-gorge"],                            nums: ["10", "11"] },
  { type: "full", id: "going-to-the-sun-valley",                                           num: "12",
    sizes: "(orientation: landscape) 151vh, 100vw" },
  /* the turn: two warm lights as the day dies, then winter's showpiece */
  { type: "pair", ids: ["durham-chesterfield-warehouse", "snowy-tennis-court-lamppost-night"], nums: ["13", "14"] },
  { type: "full", id: "snow-umbrellas-park",                                               num: "15",
    sizes: "(orientation: landscape) 133vh, 100vw" },
  /* the stark west: color falls away with the circus stripes */
  { type: "pair", ids: ["circus-circus-clown-las-vegas", "de-young-museum-tower"],         nums: ["16", "17"] },
  { type: "full", id: "architectural-cutout-smokestack",                                   num: "18",
    sizes: "(orientation: landscape) 133vh, 100vw" },
  { type: "pair", ids: ["paddleboarder-lake-mcdonald", "low-water"],                       nums: ["19", "20"] },
  { type: "pair", ids: ["not-in-use-tanks", "white-tower"],                                nums: ["21", "22"] },
  /* home: one lit window answers the fisherman */
  { type: "full", id: "one-window-twilight",                                               num: "23", closer: true,
    sizes: "(orientation: landscape) min(64vh, 900px), 92vw" },
];

const heroPhoto = get(hero.id);
---
<Base
  title=""
  description="Photographs by Nate Jones — Durham, North Carolina."
>
  {/* HERO — frame 01, full bleed */}
  <section class="hero" id="top" data-screen-label="Hero">
    <button
      type="button"
      class="tile"
      aria-label={`Open ${heroPhoto.title} in full view`}
      data-num={hero.num}
      data-title={heroPhoto.title}
    >
      <Image
        src={heroPhoto.src}
        alt={heroPhoto.alt}
        widths={[800, 1300, 1800, 2400]}
        sizes="100vw"
        loading="eager"
        decoding="async"
      />
    </button>
    <div class="hero-meta">
      <div>
        <h1 class="hero-mark">natemakesgrain<span class="dot">.</span></h1>
        <p class="hero-byline">photographs by Nate Jones — Durham, North Carolina</p>
      </div>
      <p class="hero-count">23 FRAMES ↓</p>
    </div>
  </section>

  {spreads.map((s, si) => {
    const anchor = si === 0 ? "work" : undefined;

    if (s.type === "full") {
      const p = get(s.id);
      return (
        <section class:list={["spread", "full", s.closer && "closer"]} id={anchor}>
          <div class="stack">
            <button
              type="button"
              class="tile"
              aria-label={`Open ${p.title} in full view`}
              data-num={s.num}
              data-title={p.title}
            >
              <Image
                src={p.src}
                alt={p.alt}
                widths={[800, 1300, 1800, 2400]}
                sizes={s.sizes}
                loading="lazy"
                decoding="async"
              />
            </button>
            <div class="frame-num">{s.num}</div>
          </div>
        </section>
      );
    }

    const [a, b] = s.ids.map(get);
    const [na, nb] = s.nums;
    return (
      <section class="spread pair" id={anchor}>
        <figure>
          <button
            type="button"
            class="tile"
            aria-label={`Open ${a.title} in full view`}
            data-num={na}
            data-title={a.title}
          >
            <Image
              src={a.src}
              alt={a.alt}
              widths={[400, 600, 900, 1200]}
              sizes="(max-width: 760px) 100vw, (max-width: 1700px) 45vw, 765px"
              loading="lazy"
              decoding="async"
            />
          </button>
          <figcaption class="frame-num">{na}</figcaption>
        </figure>
        <figure>
          <button
            type="button"
            class="tile"
            aria-label={`Open ${b.title} in full view`}
            data-num={nb}
            data-title={b.title}
          >
            <Image
              src={b.src}
              alt={b.alt}
              widths={[400, 600, 900, 1200]}
              sizes="(max-width: 760px) 100vw, (max-width: 1700px) 45vw, 765px"
              loading="lazy"
              decoding="async"
            />
          </button>
          <figcaption class="frame-num">{nb}</figcaption>
        </figure>
      </section>
    );
  })}

  {/* CONTACT */}
  <section class="contact" id="contact" data-screen-label="Contact">
    <p class="contact-kicker">Prints · Licensing · Assignments</p>
    <h2>Working from Durham, North Carolina. The inbox is open.</h2>
    <a class="contact-mail js-copy-mail" href="mailto:nate.jones@natemakesgrain.com">nate.jones@natemakesgrain.com</a>
    <div class="contact-meta">
      <a href="https://instagram.com/natemakesgrain" rel="me noopener" target="_blank">Instagram — @natemakesgrain</a>
      <span>Durham, NC</span>
    </div>
  </section>
</Base>
