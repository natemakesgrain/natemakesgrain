---
import Base from "../layouts/Base.astro";
const subjectFromUrl = Astro.url.searchParams.get("subject") || "";
const sent = Astro.url.searchParams.get("sent") === "1";
---
<Base title="Write" description="Write a note to Nate Jones about prints, licensing, or editorial assignments.">
  <section class="standalone">
    <p class="standalone-kicker">a note</p>
    <h1 class="standalone-mark">
      Write a <em>note.</em>
    </h1>

    <p class="standalone-lede">
      Prints, licensing, editorial assignments, or just to say hello. Replies come from my own inbox, not a form.
    </p>

    {sent && (
      <p id="thanks" class="thanks">
        Thank you. The note came through and I will reply soon.
      </p>
    )}

    <form
      class="form"
      name="contact"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      action="/contact/?sent=1"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="honey">
        <label>Leave this empty: <input name="bot-field" /></label>
      </p>

      <label>
        <span>Your name</span>
        <input type="text" name="name" required autocomplete="name" />
      </label>
      <label>
        <span>Your email</span>
        <input type="email" name="email" required autocomplete="email" />
      </label>
      <label>
        <span>Subject</span>
        <input type="text" name="subject" value={subjectFromUrl} placeholder="Print, licensing, hello..." />
      </label>
      <label>
        <span>Your message</span>
        <textarea name="message" required rows="6"></textarea>
      </label>

      <button type="submit">send the note</button>
    </form>
  </section>
</Base>
