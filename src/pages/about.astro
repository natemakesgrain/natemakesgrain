---
import Base from "../layouts/Base.astro";
---
<Base title="About" description="Nate Jones is a fine art photographer based in Durham, North Carolina.">
  <section class="standalone">
    <p class="standalone-kicker">the photographer</p>
    <h1 class="standalone-mark">
      Nate Jones, <em>Durham</em>,<br />North Carolina.
    </h1>

    <p class="standalone-lede">
      A fine art photographer based in Durham, North Carolina. The full body of work lives in <a href="/">the monograph</a>.
    </p>

    <div class="epilogue-prose">
      <p>
        Subjects find him at roadsides and in old buildings: weathered storefronts and neon, classical and brutalist architecture, the open road, and the quiet hours in between. The work is patient, observational, and almost always tied to a particular place.
      </p>
      <p>
        Prints, licensing, and editorial enquiries go straight to the inbox via <a href="/contact/">the contact page</a>.
      </p>
    </div>

    <aside class="epilogue-meta" style="margin-top: 2.5rem;">
      <dl>
        <dt>Based in</dt>
        <dd>Durham, North Carolina</dd>
        <dt>Status</dt>
        <dd>Ongoing</dd>
        <dt>Instagram</dt>
        <dd><a href="https://instagram.com/natemakesgrain" rel="me noopener" target="_blank">@natemakesgrain</a></dd>
        <dt>Write</dt>
        <dd><a href="mailto:nate.jones@natemakesgrain.com">nate.jones@natemakesgrain.com</a></dd>
      </dl>
    </aside>
  </section>
</Base>
